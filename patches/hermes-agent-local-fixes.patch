+def test_photon_media_only_routes_to_native_adapter(tmp_path) -> None:
+    platform = Platform("photon")
+    target = "+1" + "5551234567"
+    document = tmp_path / "resume.pdf"
+    document.write_bytes(b"pdf")
+    delivered = {
+        "success": True,
+        "message_id": "photon-media",
+        "media_delivered": True,
+    }
+
+    with patch(
+        "tools.send_message_tool._send_via_adapter",
+        new=AsyncMock(return_value=delivered),
+    ) as send_mock:
+        result = asyncio.run(
+            _send_to_platform(
+                platform,
+                SimpleNamespace(enabled=True, token=None, extra={}),
+                target,
+                "",
+                media_files=[(str(document), False)],
+            )
+        )
+
+    assert result == delivered
+    send_mock.assert_awaited_once()
+
+
 def test_e164_target_still_requires_phone_platform() -> None:
