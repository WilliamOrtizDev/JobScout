# Copy only non-secret path settings into your shell profile or service environment.
# Never commit a populated environment file.
HERMES_HOME=$HOME/.hermes
# Set this to a named profile directory when the job scout is not the default profile.
JOB_SEARCH_HERMES_HOME=$HERMES_HOME
JOB_SEARCH_AUTOMATION=$HOME/JobScout
JOB_SEARCH_WORKDIR=$HOME/job-search
RESUME_DIR=$HOME/job-search-resume
MASTER_RESUME_FILE=$HOME/job-search-resume/master-resume.tex
TECTONIC=$HOME/.local/bin/tectonic

# Set only when creating the Photon-delivered cron job.
PHOTON_TARGET=photon:+1XXXXXXXXXX

# Provider credentials are normally configured through `hermes model` or
# `hermes auth add`; do not place real credentials in this repository.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
